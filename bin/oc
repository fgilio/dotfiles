#!/usr/bin/env zsh
# OpenCode wrapper: works in any shell context
# Defaults to the free 0x Alpha model (opencode-go/ox-alpha-free); `opencode models`
# lists the rest — anything suffixed -free costs nothing.
# AGENT_CLI_STDIN=inherit waits on a slow pipe; AGENT_CLI_STDIN_GRACE sets the wait in ms

# Repeating -m makes yargs collect an array and opencode crashes on it, so the
# default model is added only when the caller didn't pass one in any yargs
# spelling: -m VAL, -mVAL, -m=VAL, --model VAL, --model=VAL. Args after -- are
# positionals to yargs, so the scan stops at the first -- ((i) is its index,
# or $#+1 when absent). (I)/(i) match the subscript as a pattern.
model=(-m opencode-go/ox-alpha-free)
opts=("${@[1,${@[(i)--]}-1]}")
(( ${opts[(I)-m*]} + ${opts[(I)--model]} + ${opts[(I)--model=*]} )) && model=()

if [[ $# -eq 0 || "$1" == -* ]]; then
    # Interactive: no args, or flags (--continue, etc.)
    exec opencode $model "$@"
else
    # Shared with bin/cx, bin/cl and bin/cr so the four stdin guards can't drift apart
    source "${0:h}/lib/agent-stdin.sh"

    if agent_stdin_is_idle; then
        print -ru2 -- "oc: ignoring idle stdin (AGENT_CLI_STDIN=inherit to wait for it)"
        exec </dev/null
    fi

    # Non-interactive one-shot: --auto skips permission prompts (agentic, like cx's bypass)
    exec opencode run --auto $model "$@"
fi
