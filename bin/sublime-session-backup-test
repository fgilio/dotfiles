#!/usr/bin/env bash
# Automated tests for bin/sublime-session-backup
# Runs under a throwaway $HOME so the real Sublime and Drive folders are never touched
set -uo pipefail

# Derived from the script's own location so a worktree or secondary clone
# tests its own copy, not whatever ~/.dotfiles happens to contain
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
BACKUP="$DOTFILES/bin/sublime-session-backup"

# shellcheck source=bin/lib/test-assert.sh
source "$DOTFILES/bin/lib/test-assert.sh"

sandbox="$(mktemp -d)"
cleanup() { /bin/rm -rf -- "$sandbox"; }
trap cleanup EXIT

export HOME="$sandbox/home"
LOCAL="$HOME/Library/Application Support/Sublime Text/Local"
DRIVE="$HOME/Library/CloudStorage/GoogleDrive-franco.gilio@gmail.com/My Drive"
REMOTE="$DRIVE/Apps/SublimeText4Temp"
STATE="$HOME/.local/share/sublime-session-backup"
LOG="$STATE/backup.log"
mkdir -p "$LOCAL" "$DRIVE/Apps" "$STATE"
# A failure alerts through osascript at most once a day; pretend today's alert
# already happened so no test can pop a dialog.
date +%F >"$STATE/.last-alert"

# Buffers as Sublime writes them into a session file. The same escapes are
# read back by printf %b in sha, so the digests match what the job computes.
SHOP_TXT='# Shopping list\nmilk\neggs\n'
SHOP='{"contents":"'$SHOP_TXT'","settings":{"buffer_size":24}}'
DIRTY_TXT='edited but unsaved\n'
DIRTY='{"file":"/tmp/x/notes.md","contents":"'$DIRTY_TXT'","file_size":10,"file_write_time":1,"settings":{}}'
CLEAN='{"file":"/tmp/x/clean.txt","settings":{"buffer_size":5}}'
SECOND_TXT='second untitled\n'
SECOND='{"contents":"'$SECOND_TXT'","settings":{}}'
EMPTY='{"contents":"","settings":{}}'
THIRD_TXT='a third one\n'
THIRD='{"contents":"'$THIRD_TXT'","settings":{}}'
SHOP2_TXT='# Shopping list\nmilk\neggs\nbread\n'
SHOP2='{"contents":"'$SHOP2_TXT'","settings":{"buffer_size":30}}'
OFFLINE_TXT='typed while Drive was away\n'
OFFLINE='{"contents":"'$OFFLINE_TXT'","settings":{}}'
EMPTIED='{"file":"/tmp/x/emptied.md","contents":"","file_size":40,"file_write_time":1,"settings":{}}'
LOCKED_TXT='typed while another run held the lock\n'
LOCKED='{"contents":"'$LOCKED_TXT'","settings":{}}'
FOURTH_TXT='survives a corrupt sibling\n'
FOURTH='{"contents":"'$FOURTH_TXT'","settings":{}}'

sha() { printf '%b' "$1" | shasum | cut -c1-12; }
count() { find "$1" -type f | wc -l | tr -d ' '; }
# Last log line without its timestamp
last_msg() { tail -1 "$LOG" | sed 's/^[^ ]* [^ ]*  //'; }

# write_session NAME MTIME BUFFER-JSON...
write_session() {
  local name="$1" mtime="$2"
  shift 2
  local IFS=,
  printf '{"windows":[{"buffers":[%s]}]}\n' "$*" >"$LOCAL/$name"
  touch -t "$mtime" "$LOCAL/$name"
}

write_session "Session.sublime_session" 202601011200 "$SHOP" "$DIRTY" "$CLEAN"
write_session "Auto Save Session.sublime_session" 202601011230 "$SHOP" "$DIRTY" "$SECOND" "$EMPTY" "$EMPTIED" "$CLEAN"
write_session "Backup Session.sublime_session" 202601011100 "$CLEAN"
echo 'half-written' >"$LOCAL/Auto Save Temp Session.sublime_session.tmp"

echo "first run"
echo "---------"
assert_pass "exit 0" "$BACKUP"
assert_exists "mirrors Session locally" "$STATE/Local/Session.sublime_session"
assert_exists "pushes Session" "$REMOTE/Local/Session.sublime_session"
assert_exists "pushes Auto Save Session" "$REMOTE/Local/Auto Save Session.sublime_session"
assert_exists "pushes Backup Session" "$REMOTE/Local/Backup Session.sublime_session"
assert_not_exists "skips the .tmp" "$REMOTE/Local/Auto Save Temp Session.sublime_session.tmp"
assert_pass "pushed copy is byte-identical" cmp -s "$LOCAL/Session.sublime_session" "$REMOTE/Local/Session.sublime_session"
assert_exists "untitled buffer is named after its first line" "$REMOTE/buffers/$(sha "$SHOP_TXT")_shopping-list.md"
assert_exists "dirty file-backed buffer keeps its file name" "$REMOTE/buffers/$(sha "$DIRTY_TXT")_notes.md"
assert_exists "buffer only in Auto Save Session is captured" "$REMOTE/buffers/$(sha "$SECOND_TXT")_second-untitled.md"
assert_eq "clean and empty buffers are skipped" 3 "$(count "$REMOTE/buffers")"
assert_eq "index has one line per buffer" 3 "$(wc -l <"$REMOTE/index.tsv" | tr -d ' ')"
assert_pass "buffer content is verbatim" cmp -s <(printf '%b' "$DIRTY_TXT") "$REMOTE/buffers/$(sha "$DIRTY_TXT")_notes.md"
assert_file_has "index records the source file and path" $'Auto Save Session.sublime_session\t-\t16\t' "$REMOTE/index.tsv"
assert_file_has "manifest lists the open file" '`/tmp/x/clean.txt`' "$REMOTE/latest.md"
assert_file_has "manifest flags unsaved edits on a file" '`/tmp/x/notes.md` with unsaved edits' "$REMOTE/latest.md"
assert_file_has "manifest comes from the freshest session file" 'from `Auto Save Session.sublime_session`' "$REMOTE/latest.md"
assert_file_has "manifest is dated by that file, not by the run" 'snapshot — 2026-01-01 12:30:00' "$REMOTE/latest.md"
assert_file_has "manifest shows an untitled buffer's first line" '# Shopping list' "$REMOTE/latest.md"
assert_file_has "manifest flags a file emptied without saving" '[unsaved 0B da39a3ee5e6b] `/tmp/x/emptied.md` with unsaved edits (emptied)' "$REMOTE/latest.md"
assert_eq "no temp files left behind" 0 "$(find "$REMOTE" "$STATE" -name '*.tmp' | wc -l | tr -d ' ')"
assert_eq "log reports the run" "ok: 3 new buffer(s), 3 session file(s) changed, 3 read, 8 file(s) pushed to Drive" "$(last_msg)"
assert_exists "push stamp written" "$STATE/.last-pushed"

echo ""
echo "second run, nothing changed"
echo "---------------------------"
assert_pass "exit 0" "$BACKUP"
assert_eq "no duplicate buffers" 3 "$(count "$REMOTE/buffers")"
assert_eq "nothing is pushed twice" "ok: 0 new buffer(s), 0 session file(s) changed, 3 read, 0 file(s) pushed to Drive" "$(last_msg)"

echo ""
echo "third run, edits"
echo "----------------"
write_session "Auto Save Session.sublime_session" 202601011300 "$SHOP2" "$DIRTY" "$SECOND" "$THIRD" "$CLEAN"
assert_pass "exit 0" "$BACKUP"
assert_exists "new buffer captured" "$REMOTE/buffers/$(sha "$THIRD_TXT")_a-third-one.md"
assert_exists "edited buffer lands beside the old version" "$REMOTE/buffers/$(sha "$SHOP2_TXT")_shopping-list.md"
assert_exists "old version is kept" "$REMOTE/buffers/$(sha "$SHOP_TXT")_shopping-list.md"
assert_eq "five buffers now" 5 "$(count "$REMOTE/buffers")"
assert_eq "only the changed files are pushed" "ok: 2 new buffer(s), 1 session file(s) changed, 3 read, 5 file(s) pushed to Drive" "$(last_msg)"
assert_pass "pushed copy follows the edit" cmp -s "$LOCAL/Auto Save Session.sublime_session" "$REMOTE/Local/Auto Save Session.sublime_session"

echo ""
echo "Google Drive not mounted"
echo "------------------------"
mv "$DRIVE" "$DRIVE.off"
touch "$STATE/.last-pushed"
write_session "Auto Save Session.sublime_session" 202601011330 "$SHOP2" "$DIRTY" "$SECOND" "$THIRD" "$OFFLINE" "$CLEAN"
assert_pass "recent push: exit 0" "$BACKUP"
assert_exists "local state still advances" "$STATE/buffers/$(sha "$OFFLINE_TXT")_typed-while-drive-was-away.md"
assert_eq "pending files are counted, not pushed" "ok: 1 new buffer(s), 1 session file(s) changed, 3 read, Drive not mounted, 4 file(s) pending" "$(last_msg)"
touch -t 202601011200 "$STATE/.last-pushed"
assert_fail "over a day without a push: exit 1" "$BACKUP"
assert_file_has "stale push is logged with its date" 'FAIL: Google Drive not mounted, nothing pushed since 2026-01-01 12:00' "$LOG"
/bin/rm -f "$STATE/.last-pushed"
assert_pass "first run ever: exit 0" "$BACKUP"
assert_exists "first run starts the grace period" "$STATE/.last-pushed"
mv "$DRIVE.off" "$DRIVE"
assert_pass "Drive back: exit 0" "$BACKUP"
assert_exists "pending buffer is pushed on the next mounted run" "$REMOTE/buffers/$(sha "$OFFLINE_TXT")_typed-while-drive-was-away.md"
assert_eq "exactly the pending files are pushed" "ok: 0 new buffer(s), 0 session file(s) changed, 3 read, 4 file(s) pushed to Drive" "$(last_msg)"

echo ""
echo "another run in progress"
echo "-----------------------"
/usr/bin/python3 -c 'import fcntl, sys, time; f = open(sys.argv[1], "w"); fcntl.flock(f, fcntl.LOCK_EX); time.sleep(4)' "$STATE/.lock" &
holder=$!
sleep 1
before_pushed="$(count "$STATE/pushed")"
write_session "Auto Save Session.sublime_session" 202601011430 "$SHOP2" "$DIRTY" "$SECOND" "$THIRD" "$OFFLINE" "$LOCKED" "$CLEAN"
assert_pass "locked: exit 0" "$BACKUP"
assert_eq "locked: the run is skipped" "skip: another run is in progress" "$(last_msg)"
assert_not_exists "locked: nothing is extracted" "$STATE/buffers/$(sha "$LOCKED_TXT")_typed-while-another-run-held-the-lock.md"
assert_eq "locked: nothing is pushed" "$before_pushed" "$(count "$STATE/pushed")"
wait "$holder"
assert_pass "lock released: exit 0" "$BACKUP"
assert_eq "lock released: the edit is pushed" "ok: 1 new buffer(s), 1 session file(s) changed, 3 read, 4 file(s) pushed to Drive" "$(last_msg)"
assert_exists "lock released: the buffer landed on Drive" "$REMOTE/buffers/$(sha "$LOCKED_TXT")_typed-while-another-run-held-the-lock.md"

echo ""
echo "unreadable session file"
echo "-----------------------"
before="$(count "$REMOTE/buffers")"
echo '{"windows": [' >"$LOCAL/Session.sublime_session"
touch -t 202601011500 "$LOCAL/Session.sublime_session"
write_session "Auto Save Session.sublime_session" 202601011501 "$SHOP2" "$FOURTH" "$CLEAN"
assert_fail "exit 1" "$BACKUP"
assert_file_has "unreadable file is logged" 'Session.sublime_session: unreadable, JSONDecodeError' "$LOG"
assert_file_has "run still fails loudly" 'FAIL: backup errored' "$LOG"
assert_exists "readable siblings are still extracted and pushed" "$REMOTE/buffers/$(sha "$FOURTH_TXT")_survives-a-corrupt-sibling.md"
assert_eq "exactly one new buffer" "$((before + 1))" "$(count "$REMOTE/buffers")"
assert_fail "corrupt file does not replace the last good copy" cmp -s "$LOCAL/Session.sublime_session" "$REMOTE/Local/Session.sublime_session"
assert_pass "readable siblings are still pushed" cmp -s "$LOCAL/Auto Save Session.sublime_session" "$REMOTE/Local/Auto Save Session.sublime_session"
echo '{"windows": null}' >"$LOCAL/Session.sublime_session"
touch -t 202601011502 "$LOCAL/Session.sublime_session"
assert_fail "valid JSON with the wrong shape: exit 1" "$BACKUP"
assert_file_has "wrong shape is logged" 'Session.sublime_session: unreadable, ValueError: not a Sublime session' "$LOG"
assert_fail "wrong shape does not replace the last good copy" cmp -s "$LOCAL/Session.sublime_session" "$REMOTE/Local/Session.sublime_session"

echo ""
echo "no session files"
echo "----------------"
/bin/rm -f "$LOCAL"/*.sublime_session
assert_fail "empty Local dir: exit 1" "$BACKUP"
assert_file_has "empty Local dir is logged" 'FAIL: no *.sublime_session files' "$LOG"
mv "$LOCAL" "$LOCAL.off"
assert_fail "missing Local dir: exit 1" "$BACKUP"
assert_file_has "missing Local dir is logged" 'FAIL: Sublime Local dir not found' "$LOG"

echo ""
echo "----------"
printf '%d passed, %d failed\n' "$pass" "$fail"
[[ $fail -eq 0 ]] && exit 0 || exit 1
