<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fgilio.qmd-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/fgilio/.local/bin/qmd-refresh</string>
    </array>
    <!-- Half-hourly, not a daily calendar slot: a missed slot fires on the
         next dark wake and the Mac sleeps mid-run. The script runs the refresh
         once a day, in the first slot where Franco is at the Mac. -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <!-- Throttled CPU and I/O. Measured cost: +20% embed time. -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
